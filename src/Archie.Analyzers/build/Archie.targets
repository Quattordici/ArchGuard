<Project>
  <!-- Targets, not props, so the project's own properties are set when this is evaluated. Design §4.5: the nearest archie.json wins. -->
  <PropertyGroup>
    <ArchieConfig Condition="'$(ArchieConfig)' == ''">$([MSBuild]::GetPathOfFileAbove('archie.json', '$(MSBuildProjectDirectory)'))</ArchieConfig>
  </PropertyGroup>
  <ItemGroup Condition="'$(ArchieEnabled)' != 'false' and '$(ArchieConfig)' != ''">
    <!-- Marked, so the analyzer also finds a file <ArchieConfig> names that is not called archie.json. -->
    <AdditionalFiles Include="$(ArchieConfig)" ArchieConfig="true" />
  </ItemGroup>
  <ItemGroup>
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="ArchieConfig" />
    <CompilerVisibleProperty Include="IsTestProject" />
    <CompilerVisibleProperty Include="ArchieEnabled" />
  </ItemGroup>
</Project>
