<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Loaded next to the analyzer in every host (VS on .NET Framework, Rider, csc), and later by the metadata runner: netstandard2.0 and
         no package references, so nothing can conflict with what the host already loaded. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Archie.Core.Tests" />
  </ItemGroup>
</Project>
