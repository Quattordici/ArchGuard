<Project Sdk="Microsoft.NET.Sdk">

  <!-- Drives the spike analyzer through CompilationWithAnalyzers to measure allocations and per-document latency. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- Host Roslyn matches the .NET 10.0.4xx SDK compiler so SDK source generators load; the analyzer itself compiles against 4.8. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Archie.Spike.Analyzers/Archie.Spike.Analyzers.csproj" />
  </ItemGroup>

</Project>
