<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The analyzer is compiled against RoslynFloor; it runs here on RoslynTestVersion (latest, or the floor with -p:TestAgainstFloors=true). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="$(RoslynTestVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets a test check that the Roslyn the tests load is the one asked for. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RoslynTestVersion</_Parameter1>
      <_Parameter2>$(RoslynTestVersion)</_Parameter2>
    </AssemblyAttribute>
    <!-- What the analyzer compiles against: OwnArchitectureTests compiles src/ the same way. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RoslynFloor</_Parameter1>
      <_Parameter2>$(RoslynFloor)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <!-- The conformance corpus is data (tests/Corpus/README.md): copied next to the tests, never compiled into them. -->
    <None Include="../Corpus/**/*" LinkBase="Corpus" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Archie.Analyzers/Archie.Analyzers.csproj" />
  </ItemGroup>
</Project>
